{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Tests for GET /api/hotels (Temporal + Redis). Start the stack with `docker compose up --build` first."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "1. Happy path",
      "item": [
        {
          "name": "Health (both suppliers up)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status ok', () => pm.expect(body.status).to.eql('ok'));",
                  "pm.test('both suppliers reported', () => { pm.expect(body.suppliers['Supplier A'].status).to.eql('up'); pm.expect(body.suppliers['Supplier B'].status).to.eql('up'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Delhi - deduped best offers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('no duplicate names', () => { const n = body.map(h => h.name.toLowerCase()); pm.expect(new Set(n).size).to.eql(n.length); });",
                  "pm.test('Holtin -> Supplier B @ 5340 (cheaper than A @ 6000)', () => { const h = body.find(x => x.name === 'Holtin'); pm.expect(h).to.eql({name:'Holtin', price:5340, supplier:'Supplier B', commissionPct:20}); });",
                  "pm.test('Radison -> Supplier A @ 5900 (cheaper than B @ 6200)', () => { const h = body.find(x => x.name === 'Radison'); pm.expect(h.supplier).to.eql('Supplier A'); pm.expect(h.price).to.eql(5900); });",
                  "pm.test('single-supplier hotels are kept', () => { pm.expect(body.map(h => h.name)).to.include.members(['Bloom Suites','The Leela']); });",
                  "pm.test('response shape', () => body.forEach(h => pm.expect(h).to.have.all.keys('name','price','supplier','commissionPct')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            }
          }
        },
        {
          "name": "Mumbai",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Trident -> Supplier B @ 9100', () => { const h = body.find(x => x.name === 'Trident'); pm.expect(h.supplier).to.eql('Supplier B'); pm.expect(h.price).to.eql(9100); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=mumbai",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "mumbai"
                }
              ]
            }
          }
        }
      ]
